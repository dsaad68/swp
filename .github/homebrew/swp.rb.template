# Homebrew formula for `swp`, published to the dsaad68/homebrew-tap tap.
#
#   brew install dsaad68/tap/swp
#
# This file is GENERATED by swp's release workflow (.github/workflows/release.yml)
# from .github/homebrew/swp.rb.template on each tag. Edit the template in the swp
# repository, never the copy in the tap — the next release overwrites it.
#
# It installs a prebuilt binary from the GitHub Release artifact, so no Swift
# toolchain is needed on the user's machine. The macOS build is universal
# (arm64 + x86_64); the Linux build is x86_64.
class Swp < Formula
  desc "Find what's holding a port, and kill it — native process and socket viewer"
  homepage "https://github.com/dsaad68/swp"
  version "__VERSION__"
  license "MIT"

  on_macos do
    url "https://github.com/dsaad68/swp/releases/download/v__VERSION__/swp-v__VERSION__-macos.tar.gz"
    sha256 "__MAC_SHA__"
  end

  on_linux do
    on_intel do
      url "https://github.com/dsaad68/swp/releases/download/v__VERSION__/swp-v__VERSION__-linux-x86_64.tar.gz"
      sha256 "__LINUX_SHA__"
    end
  end

  def install
    bin.install "swp"
  end

  def caveats
    <<~EOS
      Without root, macOS will not open another user's file descriptors, so the
      ports, memory and CPU of other users' processes are invisible. Run
      `sudo swp` to see them all.

      Usage:
        swp              browse everything holding a port
        swp 3000         print what's on port 3000
        swp -k 3000      kill it (asks first)
        swp --cpu -t 5   the five busiest processes
    EOS
  end

  test do
    # The version string is the one thing the release pipeline guarantees:
    # the tag, Version.swift and this formula are checked against each other
    # before any artifact is built.
    assert_match "swp __VERSION__", shell_output("#{bin}/swp --version")

    # A listing must work in the sandbox and exit cleanly. `-a` is used because
    # a build machine may well have nothing listening, and an empty match is a
    # deliberate exit 1.
    assert_match "PORT", shell_output("#{bin}/swp -l -a")
  end
end
